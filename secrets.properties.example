# Salin menjadi secrets.properties (tidak ikut git), lalu isi dari
# Supabase → Project Settings → API. Anon key memang publik (sama seperti di PWA),
# tapi tetap jangan pernah mengisi service role key di sini.

# Server UJI (semua modul) → flavor "uji"
UJI_SUPABASE_URL=https://xxxx.supabase.co
UJI_SUPABASE_ANON_KEY=

# Server RESMI (Tahap 1: generus & presensi) → flavor "resmi"
RESMI_SUPABASE_URL=https://yyyy.supabase.co
RESMI_SUPABASE_ANON_KEY=
# Ubah ke true saat Tahap 2 (modul kurikulum & capaian) dibuka di server resmi.
RESMI_FEATURE_KURIKULUM=false

# Zona waktu agenda (Asia/Jakarta = WIB, Asia/Makassar = WITA, Asia/Jayapura = WIT).
APP_TIMEZONE=Asia/Jakarta
