# Ujung baris konsisten di Windows, macOS, Linux, dan CI.
* text=auto

# Skrip shell harus LF (dijalankan di Linux/CI); skrip Windows harus CRLF.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Berkas biner: jangan diubah ujung barisnya.
*.jar binary
*.ttf binary
*.xlsx binary
*.png binary
*.jpg binary
*.webp binary
*.keystore binary
*.jks binary
